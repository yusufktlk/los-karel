datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // USER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Collection {
  id          String    @id @default(uuid())
  slug        String    @unique
  nameTR      String
  nameEN      String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String      @id @default(uuid())
  slug         String      @unique
  name         String
  price        Float
  currency     String      @default("₺")
  description  String
  story        String
  inspiration  String
  collectionId String
  collection   Collection  @relation(fields: [collectionId], references: [id])
  sizes        String // JSON or comma separated: "S,M,L,XL"
  details      String // JSON string of array items
  tags         String // JSON string of array items
  backImage    String
  frontImage   String
  tshirtImage  String
  erkekImage   String
  kadinImage   String
  kolajImage   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
}

model Order {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  totalAmount  Float
  currency     String      @default("₺")
  status       String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  customerInfo String // JSON string with name, email, address, phone
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  size      String
  quantity  Int
  price     Float
}

model JournalArticle {
  id         String   @id @default(uuid())
  slug       String   @unique
  titleTR    String
  titleEN    String
  subtitleTR String
  subtitleEN String
  date       String
  author     String
  readTime   String
  image      String
  contentTR  String // JSON string array
  contentEN  String // JSON string array
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
